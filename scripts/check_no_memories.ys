# Keep combinational case tables as mux/logic, matching the intended Quartus flow.
# Explicit memory arrays are still collected and rejected; no memory_map pass.
read_verilog *.v
hierarchy -check -top aes_xts_top_module
proc -norom
opt
memory_collect
check -assert
select -assert-none t:$mem* t:$dlatch* t:$adlatch*
stat
